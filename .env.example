# Identity QR signing key (base64 of a PKCS#8 P-256 PEM). Generate with: npm run keygen
QR_SIGNING_KEY=
# Signs the staff sign-in cookie
SESSION_SECRET=
# PIN for the staff portal (registrar and officer)
STAFF_PIN=2468

# Optional. Leave empty to run on the built-in in-memory store (resets when the server restarts).
# Fill both to store residents, applications and payments in Supabase. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
